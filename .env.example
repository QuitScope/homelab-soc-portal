# Homelab SOC Portal – copy to .env and fill in. Never commit .env.
# Values with special characters (#, $, spaces) must be in single quotes.

# --- Server ---
PORT=8080
HOST=0.0.0.0
# local dev: ./data/portal.sqlite; Docker sets /data/portal.sqlite
DB_PATH=./data/portal.sqlite
# at least 32 random characters: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# true when served via HTTPS (reverse proxy)
COOKIE_SECURE=false

# --- Login (single-user mode) ---
ADMIN_USER=admin
# npm run hash-password -- '<password>'  → scrypt:...  (leave empty = read-only portal)
ADMIN_PASSWORD_HASH=

# --- Integrations ---
# SSRF guard: only these hostnames are accepted as integration targets
INTEGRATION_ALLOWLIST=splunk,cribl
HTTP_TIMEOUT_MS=8000
# seconds between Splunk fired-alert syncs (0 = off)
INCIDENT_SYNC_INTERVAL_SEC=120
# synthetic test hosts hidden from statistics
EXCLUDE_HOST_PATTERNS=lab-reduce-*,sigma-live-*
# Splunk sources hidden everywhere, e.g. synthetic test events from the Cribl HTTP input
EXCLUDE_SOURCES=cribl:http:*

# Splunk REST (management port, internal Docker network only)
SPLUNK_URL=https://splunk:8089
SPLUNK_USER=admin
SPLUNK_PASSWORD=
# Splunk ships a self-signed certificate; only disable inside the internal network
SPLUNK_VERIFY_TLS=false
SPLUNK_INDEX=homelab_auth
SPLUNK_SOURCETYPE=homelab:auth

# Cribl Stream API
CRIBL_URL=http://cribl:9000
CRIBL_USER=admin
CRIBL_PASSWORD=

# Not deployed yet → "Not configured" (add the hostname to INTEGRATION_ALLOWLIST when set)
SHUFFLE_URL=
OPENCTI_URL=
PROMETHEUS_URL=
GRAFANA_URL=
WAZUH_URL=

# Demo incidents marked as "simulated" (development / E2E only)
SEED_DEMO=false

# --- docker compose ---
# LAN address of the VM to bind to, e.g. the IP of siem-docker
PORTAL_BIND=0.0.0.0
PORTAL_PORT=8090
SIEM_NETWORK=homelab-siem_default
